{
  "name": "brenraphaels-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=production next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "careers:db:generate": "drizzle-kit generate --config drizzle-careers.config.ts",
    "careers:db:migrate": "drizzle-kit migrate --config drizzle-careers.config.ts",
    "careers:db:seed": "node --env-file-if-exists=.env.production scripts/seed-job-postings.mjs",
    "catalog:import": "node --env-file-if-exists=.env.production scripts/import-catalog.mjs",
    "catalog:images:migrate": "node --env-file-if-exists=.env.production scripts/migrate-product-images.mjs"
  },
  "dependencies": {
    "@aivangogh/ph-address": "^2026.2.3",
    "@neondatabase/auth": "^0.5.0-beta",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@vercel/blob": "^2.8.0",
    "@vercel/queue": "^0.7.0",
    "botid": "^1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "file-type": "^22.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "ogl": "^1.0.11",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
