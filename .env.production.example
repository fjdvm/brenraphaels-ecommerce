# Production environment variables (Vercel -> Project -> Settings -> Environment Variables).
# Copy this file's keys into Vercel; never commit real values.
# Pull them locally with: vercel env pull

# --- Site ---------------------------------------------------------------
# Canonical public URL of the deployed app, no trailing slash.
# Used to build the links inside verification / password-reset emails.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# --- Cron ---------------------------------------------------------------
# Random secret; Vercel Cron sends it as "Authorization: Bearer <value>" to the daily jobs.
CRON_SECRET=

# --- GitHub feedback -----------------------------------------------------
# Fine-grained token with Issues: Read and write access to the target repository.
GITHUB_FEEDBACK_TOKEN=
# Owner/name of the repository where visitor reports become issues.
GITHUB_FEEDBACK_REPOSITORY=owner/repository

# --- Neon Postgres ------------------------------------------------------
# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection string. Used only by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Neon Auth (Managed Better Auth) --------------------------------------
# Auth base URL of the Neon branch this deployment uses (Neon Console -> Auth).
# The webhook signature check derives its JWKS URL from this: <base>/.well-known/jwks.json
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
# Secret that signs the session cookie. At least 32 characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Brevo SMTP (transactional email, sent from our Neon Auth webhook) ------
# Also used by Careers to send its own "Application received" confirmation
# (ADR-0005) — same credentials, same sender identity, no separate config.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# Brevo SMTP login (shown in Brevo -> SMTP & API -> SMTP), not your account password.
BREVO_SMTP_USER=
# Brevo SMTP key (generated in the same page).
BREVO_SMTP_KEY=
# Must be a sender / domain verified in Brevo, or messages are rejected or land in spam.
EMAIL_FROM_ADDRESS=no-reply@your-production-domain.com
EMAIL_FROM_NAME=Bren Raphael's Ube Jam & Halaya

# --- Storefront: Vercel Blob (GCash payment-proof screenshots, private store) -
# Optional. Without it, a Customer can still submit a GCash reference number;
# only the optional screenshot upload is disabled.
ORDERS_BLOB_READ_WRITE_TOKEN=

# --- API gateway (live Ticket conversations) --------------------------------
# Base address of the api-gateway, no trailing slash.
API_GATEWAY_URL=
# The storefront's Caller key, sent as "Authorization: Bearer <key>". Server-side only: never prefix with
# NEXT_PUBLIC_. Used to get the short-lived Live ticket a Customer's browser opens a Ticket conversation with.
API_GATEWAY_CALLER_KEY=


# --- Careers: Neon Postgres (own project, separate from the Storefront's) ---
# See ADR-0006. Holds Applicant profiles, the Job-Posting cache synced from
# HR-ATS, and Application records — never the Storefront's customers/orders.
CAREERS_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
CAREERS_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Careers: Neon Auth (own Managed Better Auth instance) ------------------
# Separate instance from NEON_AUTH_BASE_URL above (ADR-0006), so the same
# email can be a Customer in one and an Applicant in the other with no clash.
CAREERS_NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
CAREERS_NEON_AUTH_COOKIE_SECRET=

# --- Careers: Vercel Blob (Applicant documents, private store) --------------
# Documents (resume, transcript, IDs) live here for now, not shared with
# HR-ATS's own storage (ADR-0005 consequences). Connected private stores get
# short-lived OIDC credentials automatically; BLOB_STORE_ID identifies which
# store to use and is injected by Vercel when the store is linked to this
# project — set it manually only for local dev against a specific store.
BLOB_STORE_ID=

# --- Careers: Vercel Queues (durable delivery to HR-ATS) --------------------
# No credential to set here: @vercel/queue authenticates via this Vercel
# project's own linkage (`vercel link` / `vercel env pull`), same as Blob's
# OIDC path. Listed for visibility only.

# --- Careers: HR-ATS integration --------------------------------------------
# HR-ATS is a separate application with its own database (see CONTEXT-MAP.md,
# ADR-0005). Outbound: this app calls HR-ATS to deliver submitted/withdrawn
# Applications. Inbound: HR-ATS calls back to sync Job Postings and push
# Application status changes; the webhook secret verifies those calls came
# from HR-ATS.
HR_ATS_API_BASE_URL=https://hr-ats.your-company-domain.com/api
HR_ATS_API_KEY=
HR_ATS_WEBHOOK_SECRET=
